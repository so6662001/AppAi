<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48:兼容老 ERP 客户端;net8.0-windows:新客户端 -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SteelGuard.AntiRpa</RootNamespace>
    <AssemblyName>SteelGuard.AntiRpa.Windows</AssemblyName>
    <Description>ERP 客户端防 RPA - Windows / WinForms 实现(低级钩子、UIA 探针、进程扫描、防截屏、网格护盾、剪贴板守卫)</Description>
    <Version>0.1.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteelGuard.AntiRpa.Core\SteelGuard.AntiRpa.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
